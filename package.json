    "tls",
    "inspector"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "docs:build": "bun run docs/demo/build.ts"
  },
  "type": "module"
