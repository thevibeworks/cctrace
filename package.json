{
  "name": "@thevibeworks/cctrace",
  "version": "0.53.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevibeworks/cctrace.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "marked": "^18.0.9",
